# Copy this file to .env for LOCAL testing only.
# NEVER commit a real .env file. In GitHub Actions, these same variable
# names are populated from repository Secrets - see
# .github/workflows/daily.yml and docs/SECURITY.md.

# --- SMS Gateway for Android (Cloud Mode) credentials ---------------------
# Created inside the Android app: Settings > Cloud Server > "3rd party" tab.
SMS_GATEWAY_USERNAME=your_cloud_username
SMS_GATEWAY_PASSWORD=your_cloud_password

# Optional overrides (defaults shown):
SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_TIMEOUT_SECONDS=15
SMS_GATEWAY_MAX_RETRIES=4
SMS_GATEWAY_RETRY_BACKOFF_BASE=2.0
SMS_GATEWAY_RETRY_BACKOFF_MAX=30.0
# Leave unset unless the phone has multiple SIMs and you need to pin one:
# SMS_GATEWAY_SENDER_SIM=1

# --- Application settings --------------------------------------------------
BIRTHDAY_CSV_PATH=data/birthdays.csv
BIRTHDAY_TIMEZONE=Asia/Kolkata
DEFAULT_MESSAGE_TEMPLATE=Happy Birthday {FIRST_NAME}! Wishing you a wonderful year ahead. - From your teacher
LOG_LEVEL=INFO
STATE_FILE_PATH=data/.sent_state.json

# Set to true to render messages and log them WITHOUT calling the gateway.
DRY_RUN=false
